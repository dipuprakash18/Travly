<% layout("/layouts/boilerplate")%>
<body>
      <style>
      #filters {
      display: flex;
      align-items: center;
      gap: 2rem;
      flex-wrap: nowrap;
      overflow: hidden;
      margin-top: 1.25rem;
      margin-bottom: 1.25rem;
      }
      #filters a{
        text-decoration: none;
        color: black;
      }

      .filter {
      text-align: center;
      opacity: 0.6;
      flex-shrink: 0;
      }

      .filter:hover {
      opacity: 1;
      cursor: pointer;
      }

      .filter p {
      font-size: 0.8rem;
      margin-bottom: 0;
      }

      .tax-toggler {
      flex-shrink: 0;
      border: 1px solid black;
      height: 3.25rem;
      border-radius: 1rem;
      padding: 1rem;
      display: flex;
      align-items: center;
      margin-left: auto;
      }

      </style>
      
      

 <div id="filters">
    
    <a href="/listings?category=Trending"  class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms"  class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic Cities"  class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>

    <!-- Hide on screens smaller than lg -->
    <a href="/listings?category=Mountains" class="filter d-none d-lg-block">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles" class="filter d-none d-lg-block">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Amazing Pools" class="filter d-none d-lg-block">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter d-none d-xl-block">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Arctic" class="filter d-none d-xl-block">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Farms"class="filter d-none d-xxl-block">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>

    <a href="/listings?category=Boats" class="filter d-none d-xxl-block">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>

    <div class="tax-toggler">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="switchCheckDefault">

            <label class="form-check-label" for="switchCheckDefault">
                Display total after taxes
            </label>
        </div>
    </div>

</div>
      <div class="row row-cols-lg-4  row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(listing of allListings){ %>
               <a href="/listings/<%= listing._id %>" class="listing-link">
                  <div class="card col listing-card">
                              <img src="<%= listing.image.url %>" class="card-img-top" alt="
                              listing" style="height: 20rem;">
                              <div class="card-img-overlay"></div>
                              <div class="card-body">
                              <p class="card-text">
                                    <b><%= listing.title %></p></b>
                               &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %>/night
                               <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                              </div>
                  </div>
               </a>   
            <%} %>
      </div>

</body>

<script>
      let taxSwitch = document.getElementById('switchCheckDefault');
      taxSwitch.addEventListener("click",()=>{
            let taxInfo = document.getElementsByClassName("tax-info");
           for(info of taxInfo){
              if(info.style.display != "inline"){
                  info.style.display = "inline";
              }else{
                  info.style.display = "none";
              }
              
           }
      });
</script>