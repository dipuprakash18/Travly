<% layout("/layouts/boilerplate")%>
<style>
      .category-dropdown {
    position: relative;
    width: 100%;
}

.category-btn {
    width: 100%;
    background: white;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
    cursor: pointer;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.category-btn:hover {
    border-color: #86b7fe;
}

.category-menu {
    display: none;

    position: absolute;
    top: 100%;
    left: 0;

    width: 100%;
    max-height: 250px;
    overflow-y: auto;

    background: white;
    border: 1px solid #ced4da;
    border-radius: 6px;

    padding: 8px;

    margin-top: 4px;

    z-index: 9999;
}

.category-menu.show {
    display: block;
}

.category-menu label {
    display: block;
    padding: 8px;
    cursor: pointer;
    border-radius: 4px;
}

.category-menu label:hover {
    background-color: #f5f5f5;
}

.category-menu input {
    margin-right: 8px;
}
</style>
<body>
      <div class="row mt-3">
         <div class="col-8 offset-2">
            <form 
              method="POST" 
              action="/listings/<%= listingOne._id %>?_method=PUT"
              novalidate
              class="needs-validation"
              enctype="multipart/form-data"
              >
                  <br>
                  <h2>Edit your Listing</h2>
                  <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input 
                        name="listing[title]" 
                        value="<%= listingOne.title %>" 
                        type="text" 
                        class="form-control"
                        required
                        />
                        <div class="valid-feedback">Title looks good!.</div>
                        <div class="invalid-feedback">Title should be valid.</div>
                  </div>
                  <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea 
                        name="listing[description]" 
                        type="text" 
                        class="form-control"
                        required
                        ><%= listingOne.description %></textarea>
                        <div class="invalid-feedback">Please write the short discription.</div>
                  </div>
                  <div class="mb-3">
                        Original Image <br>
                        <img src="<%= originalImageUrl %>"/>
                  </div>
                  <div class="mb-3">
                        <label for="image" class="form-label">Upload New Image</label>
                        <input 
                        name="listing[image]" 
                        type="file" 
                        class="form-control"  
                        />
                  </div>
                  <div class="mb-3">
                        <label class="form-label">Category</label>
                        <div class="category-dropdown">
                              <button
                                    type="button"
                                    id="categoryBtn"
                                    class="category-btn"
                              >
                                    <%= listingOne.category.join(", ") %>
                                    <span>▼</span>
                              </button>

                              <div id="categoryMenu" class="category-menu">
                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Trending"
                                          <%= listingOne.category.includes("Trending") ? "checked" : "" %>
                                    >
                                    Trending
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Rooms"
                                          <%= listingOne.category.includes("Rooms") ? "checked" : "" %>
                                    >
                                    Rooms
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Iconic Cities"
                                          <%= listingOne.category.includes("Iconic Cities") ? "checked" : "" %>
                                    >
                                    Iconic Cities
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Mountains"
                                          <%= listingOne.category.includes("Mountains") ? "checked" : "" %>
                                    >
                                    Mountains
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Castles"
                                          <%= listingOne.category.includes("Castles") ? "checked" : "" %>
                                    >
                                    Castles
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Amazing Pools"
                                          <%= listingOne.category.includes("Amazing Pools") ? "checked" : "" %>
                                    >
                                    Amazing Pools
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Camping"
                                          <%= listingOne.category.includes("Camping") ? "checked" : "" %>
                                    >
                                    Camping
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Arctic"
                                          <%= listingOne.category.includes("Arctic") ? "checked" : "" %>
                                    >
                                    Arctic
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Farms"
                                          <%= listingOne.category.includes("Farms") ? "checked" : "" %>
                                    >
                                    Farms
                                    </label>

                                    <label>
                                    <input
                                          type="checkbox"
                                          name="listing[category]"
                                          value="Boats"
                                          <%= listingOne.category.includes("Boats") ? "checked" : "" %>
                                    >
                                    Boats
                                    </label>

                              </div>
                        </div>
                        </div>
                  <div class="row">
                        <div class="mb-3 col-md-4">
                              <label for="price" class="form-label">Price</label>
                              <input 
                              name="listing[price]" 
                              value="<%= listingOne.price %>" 
                              type="number" 
                              class="form-control"
                              required
                              />
                              <div class="invalid-feedback">Price should be valid.</div>
                        </div>
                        <div class="mb-3 col-md-8">
                              <label for="Country" class="form-label">Country</label>
                              <input 
                              name="listing[country]" 
                              value="<%= listingOne.country %>" 
                              type="text" 
                              class="form-control"
                              required
                              />
                              <div class="invalid-feedback">Country should be valid.</div>
                        </div>
                  </div>
                  
                  <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input 
                        name="listing[location]" 
                        value="<%= listingOne.location %>" 
                        type="text" 
                        class="form-control"
                        required
                        />
                        <div class="invalid-feedback">Location should be valid.</div>
                  </div>
                  <button class="btn btn-dark edit-btn mt-3 mb-5">Edit</button>
         
            </form>
          </div>  
      </div>
      <script>
            const categoryBtn = document.getElementById("categoryBtn");
            const categoryMenu = document.getElementById("categoryMenu");

            categoryBtn.addEventListener("click", function () {
                  categoryMenu.classList.toggle("show");
            });

            const checkboxes = document.querySelectorAll(
                  'input[name="listing[category]"]'
            );

            checkboxes.forEach(function (checkbox) {

                  checkbox.addEventListener("change", function () {

                        const selected = [];

                        checkboxes.forEach(function (cb) {
                        if (cb.checked) {
                              selected.push(cb.value);
                        }
                        });

                        if (selected.length === 0) {
                        categoryBtn.innerHTML = "Select Categories <span>▼</span>";
                        } else {
                        categoryBtn.innerHTML =
                              selected.join(", ") + " <span>▼</span>";
                        }

                  });

            });
      </script>
</body>
